# backend environments
GEMINI_API_KEY=your_gemini_api_key
MAPS_API_KEY=your_google_maps_api_key
FIREBASE_DATABASE_URL=your_firebase_rtdb_url
FIREBASE_CREDENTIALS={"type": "service_account", ...} # Paste full JSON content here
ALLOWED_ORIGIN=http://localhost:5173

# frontend environments (Vite requires VITE_ prefix)
VITE_MAPS_API_KEY=your_google_maps_api_key
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_DATABASE_URL=your_firebase_rtdb_url
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
